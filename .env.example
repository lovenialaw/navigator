# Copy to .env and fill in. All optional: placeholders keep the app launchable.
# Restart `npm start` (with --clear) after editing; Metro inlines these at bundle time.

# Full URL of the MapLibre style JSON that points at malaysia.pmtiles
EXPO_PUBLIC_TUJU_STYLE_URL=
# Id of the vector source in that style that offline packs replace (default: malaysia)
EXPO_PUBLIC_TUJU_STYLE_SOURCE_ID=
# Directory URL hosting klang-valley.pmtiles, pahang-east-coast.pmtiles, sabah.pmtiles, sarawak.pmtiles
EXPO_PUBLIC_TUJU_PACK_BASE_URL=
# Per-pack overrides (win over the base URL)
EXPO_PUBLIC_TUJU_PACK_URL_KLANG_VALLEY=
EXPO_PUBLIC_TUJU_PACK_URL_PAHANG_EAST_COAST=
EXPO_PUBLIC_TUJU_PACK_URL_SABAH=
EXPO_PUBLIC_TUJU_PACK_URL_SARAWAK=

# Routing and search default to free PUBLIC servers (dev only: fair-use limits, no uptime promise).
# Self-host both before a public release. See docs/route-planner.md.
# Set a URL to an RFC 2606 .invalid host (e.g. https://valhalla.tuju.invalid) for offline DEMO mode.
# Valhalla base URL (the app calls <base>/route). Default: https://valhalla1.openstreetmap.de
EXPO_PUBLIC_TUJU_VALHALLA_URL=
# Photon base URL (the app calls <base>/api). Default: https://photon.komoot.io
EXPO_PUBLIC_TUJU_PHOTON_URL=

# Overpass interpreter used once per route for R&R / petrol / EV stops. Default: https://overpass-api.de/api/interpreter
# Set to an RFC 2606 .invalid host (https://overpass.tuju.invalid/api/interpreter) for sample stops with no network.
EXPO_PUBLIC_TUJU_OVERPASS_URL=
# JSON feed of flood / landslide alerts (see docs/along-your-route.md). Blank = no feed.
EXPO_PUBLIC_TUJU_ALERTS_URL=
